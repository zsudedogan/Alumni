# PostgreSQL Configuration (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL
# In Docker: postgresql+psycopg2://postgres:postgres@db:5432/fastapi_db
# In Local Dev (without Docker): sqlite:///./app.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/fastapi_db
LOCAL_DATABASE_URL=sqlite:///./app.db

# Application Configuration
APP_ENV=development
APP_PORT=8000
